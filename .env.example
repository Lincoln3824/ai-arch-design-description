# 复制本文件为 .env，然后填入你的 Key
# .env 不要提交到 git、不要发给别人

# ============ 方案一（默认）：通义千问 VL / 阿里云百炼 DashScope ============
# 获取地址：https://bailian.console.aliyun.com/  →  右上角「API-KEY」
DASHSCOPE_API_KEY=sk-在这里填你的通义千问-KEY

# ============ 方案二：OpenAI 视觉模型 ============
# 获取地址：https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-在这里填你的OpenAI-KEY

# ============ 可选设置 ============
# 默认服务商，不填就是 dashscope
# DESIGN_LLM_PROVIDER=dashscope
